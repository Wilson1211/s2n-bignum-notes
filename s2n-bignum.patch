diff --git a/tools/build-proof.sh b/tools/build-proof.sh
index 39d72433..4dbb8a4b 100755
--- a/tools/build-proof.sh
+++ b/tools/build-proof.sh
@@ -48,10 +48,37 @@ if [ -d "${HOLLIGHT_DIR}/_opam" ]; then
   eval $(opam env --switch "${HOLLIGHT_DIR}/" --set-switch)
 fi
 
+inlined_raw="$(mktemp).ml"
 inlined_prefix="$(mktemp)"
 inlined_ml="${inlined_prefix}.ml"
 inlined_cmx="${inlined_prefix}.cmx"
-ocaml ${HOLLIGHT_DIR}/inline_load.ml ${template_ml} ${inlined_ml}
+${HOLLIGHT_DIR}/hol.sh inline-load ${template_ml} ${inlined_raw}
+
+if [ "${THM_DUMP_DIR}" == "" ]; then
+  echo "THM_DUMP_DIR is empty! Do 'export THM_DUMP_DIR=(your path)', or theorems are not exported."
+else
+  mkdir -p ${THM_DUMP_DIR}
+
+  dst_filename=$(basename ${ml_path_noarch})
+  dst_filename=${dst_filename%.ml}_inlined.ml
+
+  python3 ${HOLLIGHT_DIR}/TacticTrace/remove-linenum-dirs.py ${inlined_raw} ${THM_DUMP_DIR}/${dst_filename}
+  ${HOLLIGHT_DIR}/TacticTrace/get-ast.sh ${THM_DUMP_DIR}/${dst_filename}
+  ${HOLLIGHT_DIR}/TacticTrace/tracer collect-toplevel-thms \
+    ${THM_DUMP_DIR}/${dst_filename%.ml}.marshalled.bin \
+    ${THM_DUMP_DIR}/$(basename $ml_path).json
+fi
+
+if [ "${TRACE_DUMP_DIR}" == "" ]; then
+  echo "TRACE_DUMP_DIR is empty! Do 'export TRACE_DUMP_DIR=(your path)', or trace won't be generated."
+  cp $inlined_raw $inlined_ml
+else
+  mkdir -p ${TRACE_DUMP_DIR}
+  ${HOLLIGHT_DIR}/TacticTrace/modify-proof.sh ${inlined_raw} ${inlined_ml} "${TRACE_DUMP_DIR}/$(basename $ml_path)"
+fi
+echo "THM_DUMP_DIR: ${THM_DUMP_DIR}"
+echo "TRACE_DUMP_DIR: ${TRACE_DUMP_DIR}"
+echo "Compiling: ${inlined_ml}"
 
 # Give a large stack size.
 OCAMLRUNPARAM=l=2000000000 \
